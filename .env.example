# The bot reads this file (bot/.env) and nothing else. Copy it: cp .env.example .env

# The same database the backend uses. This is how the two share shorts, users and settings.
MONGODB_URI=mongodb://127.0.0.1:27017/shorts_scheduler_saas

# The same Google OAuth client the backend uses (Google Cloud Console > Google Auth Platform >
# Clients). The bot needs it to refresh the stored Drive and YouTube sign-ins.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# How often the bot checks for due shorts, and how many it uploads at once.
BOT_POLL_SECONDS=30
BOT_CONCURRENCY=2
